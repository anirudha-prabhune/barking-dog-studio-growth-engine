# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/barking_dog_growth

# Redis Cache / Future Queue
REDIS_URL=redis://localhost:6379/0

# Backend Authentication Secret Key
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# Frontend API Target (Vite development proxy or direct API URL)
VITE_API_URL=http://localhost:8001

# Backend CORS Allowed Frontend Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Application Environment
ENVIRONMENT=development
APP_NAME="Barking Dog Growth Engine"

# Initial Team Administrator Credentials (used by seed script)
ADMIN_EMAIL=admin@barkingdog.studio
ADMIN_PASSWORD=

# GEMINI_API_KEY: Future AI Model Integration (Pass 3)
GEMINI_API_KEY=

# APP_URL: Runtime Cloud Run / local URL
APP_URL=http://localhost:3000
